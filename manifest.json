{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "short_name": "FocusShield",
  "version": "1.0.0",
  "description": "__MSG_extension_description__",
  "default_locale": "en",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "src/ui/dashboard.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_title": "Focus & Content Shield"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "contextMenus",
    "alarms"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_static_baseline",
        "enabled": true,
        "path": "src/rulesets/static_rules.json"
      }
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/page-guard.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/blocked.html",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
